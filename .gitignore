# Build artifacts
/build/
/bin/
*.exe
*.exe~
*.syso

# Go tooling output (profiling, coverage, test binaries)
*.prof
*.pprof
*.test
coverage.out
*.cover

# Go workspace (machine-local)
go.work
go.work.sum

# Local runtime data
/.localdata*/
/data/
/workspaces/
workspaces.json
*.db
*.db-shm
*.db-wal
credential-secret

# Local dev logs + scratch (not part of the project)
# _devlogs/: dev.ps1 lifecycle log + captured backend stderr (crash traces).
/_devlogs/
*.log
*.log.err
*.err
/_be.log
/_be.err.log
/.backend.log
/.frontend.log
/_agentid.txt
/.flowids.json
/.testids.json
/.mcptest/
/frontend/tionharness_title_test.mjs
# Playwright MCP page snapshots — regenerated on every UI test run.
/.playwright-mcp/
# Vite's pre-bundled dependency cache.
/.vite/

# Dependencies
/frontend/node_modules/
/frontend/dist/
# Embedded frontend build output (generated by `npm run build`); keep placeholder.
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# Env
.env
.env.local

# OS
Thumbs.db
.DS_Store

# Agent runtime working-dir state (persistent progress)
.tionharness/
