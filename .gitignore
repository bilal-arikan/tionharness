# Build artifacts
/build/*
/bin/
/dist/
*.exe
*.exe~
*.syso
# Windows resource objects (app icon + version info) are generated once from
# build/windows/ and committed, so plain `go build` produces a branded exe.
!cmd/*/rsrc_windows_*.syso
!/build/windows/

# Go tooling output (profiling, coverage, test binaries)
*.prof
*.pprof
*.test
coverage.out
*.cover

# Python repair tooling caches
__pycache__/
*.pyc

# Go workspace (machine-local)
go.work
go.work.sum

# Local runtime data
/.localdata*/
/data/
/workspaces/
workspaces.json
*.db
*.db-shm
*.db-wal
credential-secret

# Local dev logs + scratch (not part of the project)
# _devlogs/: dev.ps1 lifecycle log + captured backend stderr (crash traces).
/_devlogs/
# .scratch/: agent scratchpad (task dumps, API responses) - local only.
/.scratch/
*.log
*.log.err
*.err
/.flowids.json
/.testids.json
# Playwright MCP page snapshots — regenerated on every UI test run.
/.playwright-mcp/
# Vite's pre-bundled dependency cache.
/.vite/

# Dependencies
/node_modules/
/frontend/node_modules/
/frontend/dist/
# Embedded frontend build output (generated by `npm run build`); keep placeholder.
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# Promo site (_Docs/72). Static output + Astro's generated type cache.
/website/node_modules/
/website/dist/
/website/.astro/
# Captured product screenshots (regenerate with scripts\shots.ps1); keep placeholder.
/website/public/shots/*
!/website/public/shots/.gitkeep

# Env
.env
.env.local

# OS
Thumbs.db
.DS_Store

# Agent runtime working-dir state (persistent progress)
.tionharness/

# zvec-grep local semantic index (machine state: embeddings, locks, manifest).
# Rebuilt on demand with `zg index`; never shared.
.zvec-grep/

# Machine-specific agent approvals and local paths.
/.claude/settings.local.json

# Generated output left at the former gateway experiment location.
/_spikes/52-gateway/
