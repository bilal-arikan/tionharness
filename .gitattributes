# Normalize line endings in the repository: every text file is stored with LF
# in the index. Without this, core.autocrlf on Windows checkouts leaks CRLF into
# committed blobs, which makes `git diff --check` report phantom trailing
# whitespace and breaks shell scripts that must stay LF.
* text=auto

# Files that are executed as scripts must keep LF in the working tree too,
# otherwise bash rejects them on Windows (the pre-commit hook hit exactly this).
*.sh text eol=lf
.githooks/* text eol=lf

# Windows-only scripts must keep CRLF in the working tree.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never touch the bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.zst binary
*.exe binary
