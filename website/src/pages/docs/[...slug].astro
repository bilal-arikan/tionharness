---
import { getCollection, render } from 'astro:content'
import Docs from '../../layouts/Docs.astro'
import { assertNavMatchesCollection } from '../../content/docsNav'

export async function getStaticPaths() {
  const entries = await getCollection('docs')
  // A nav entry with no file, or a file with no nav entry, is a build failure --
  // silently dropping either would ship a dead link or an unreachable page.
  assertNavMatchesCollection(entries.map((entry) => entry.id))

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
---

<Docs
  id={entry.id}
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
>
  <h1>{entry.data.title}</h1>
  <Content />
</Docs>
