---
import Base from '../layouts/Base.astro'
import CTAButton from '../components/CTAButton.astro'
---

<Base title="Not found" description="This page does not exist.">
  <div class="glow-radial mx-auto flex max-w-2xl flex-col items-center px-6 py-32 text-center">
    <p class="font-mono text-6xl font-semibold text-[var(--color-accent)]">404</p>
    <h1 class="mt-6 text-2xl font-semibold tracking-tight">No session at this address</h1>
    <p class="mt-3 text-[var(--color-text-dim)]">
      The page you asked for was never spawned. Head back to the start.
    </p>
    <CTAButton href="/" class="mt-8" icon="arrow">Back home</CTAButton>
  </div>
</Base>
