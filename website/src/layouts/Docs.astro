---
import type { MarkdownHeading } from 'astro'
import Base from './Base.astro'
import { docsHref, docsNav, docsNeighbours } from '../content/docsNav'

interface Props {
  /** Collection id of the current page: `<section>/<slug>`. */
  id: string
  title: string
  description: string
  /** Headings emitted by `render(entry)`; only h2/h3 reach the table of contents. */
  headings: MarkdownHeading[]
}

const { id, title, description, headings } = Astro.props

const section = docsNav.find((candidate) => candidate.pages.some((p) => `${candidate.id}/${p.slug}` === id))
if (!section) {
  throw new Error(`Docs.astro: "${id}" is not listed in docsNav`)
}

const { prev, next } = docsNeighbours(id)
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3)

const navLinkBase =
  'block rounded-md px-3 py-1.5 text-sm transition hover:text-[var(--color-accent)]'
const pagerBase =
  'flex-1 rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-3 transition hover:border-[var(--color-accent)]'
---

<Base title={title} description={description}>
  <div
    class="mx-auto flex max-w-7xl flex-col gap-10 px-4 py-10 sm:px-6 lg:flex-row lg:px-8"
  >
    <!--
      Sidebar: a sticky column from `lg:` up, and simply the first scrollable
      block on the page below that. No drawer, so no JavaScript.
    -->
    <nav aria-label="Documentation" class="w-full shrink-0 lg:sticky lg:top-20 lg:h-fit lg:w-56">
      {
        docsNav.map((entry) => (
          <div class="mb-6">
            <p class="mb-2 px-3 text-xs font-semibold tracking-wider text-[var(--color-text-dim)] uppercase">
              {entry.label}
            </p>
            <ul>
              {entry.pages.map((page) => {
                const pageId = `${entry.id}/${page.slug}`
                const current = pageId === id
                return (
                  <li>
                    <a
                      href={docsHref(pageId)}
                      aria-current={current ? 'page' : undefined}
                      class={`${navLinkBase} ${
                        current
                          ? 'bg-[var(--color-accent-soft)] font-medium text-[var(--color-accent)]'
                          : 'text-[var(--color-text-dim)]'
                      }`}
                    >
                      {page.label}
                    </a>
                  </li>
                )
              })}
            </ul>
          </div>
        ))
      }
    </nav>

    <article class="min-w-0 flex-1">
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-[var(--color-text-dim)]">
        <a href="/docs" class="transition hover:text-[var(--color-accent)]">Docs</a>
        <span class="mx-2">/</span>
        <span>{section.label}</span>
        <span class="mx-2">/</span>
        <span class="text-[var(--color-text)]">{title}</span>
      </nav>

      <div class="prose">
        <slot />
      </div>

      <div class="mt-14 flex flex-col gap-3 border-t border-[var(--color-border)] pt-6 sm:flex-row">
        {
          prev && (
            <a href={prev.href} class={pagerBase} rel="prev">
              <span class="block text-xs text-[var(--color-text-dim)]">Previous</span>
              <span class="block">{prev.label}</span>
            </a>
          )
        }
        {
          next && (
            <a href={next.href} class={`${pagerBase} sm:text-right`} rel="next">
              <span class="block text-xs text-[var(--color-text-dim)]">Next</span>
              <span class="block">{next.label}</span>
            </a>
          )
        }
      </div>
    </article>

    {
      toc.length > 0 && (
        <nav
          aria-label="On this page"
          class="hidden w-56 shrink-0 xl:sticky xl:top-20 xl:block xl:h-fit"
        >
          <p class="mb-2 text-xs font-semibold tracking-wider text-[var(--color-text-dim)] uppercase">
            On this page
          </p>
          <ul class="space-y-1 border-l border-[var(--color-border)]">
            {toc.map((heading) => (
              <li>
                <a
                  href={`#${heading.slug}`}
                  class={`block border-l border-transparent py-0.5 text-sm text-[var(--color-text-dim)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] ${
                    heading.depth === 3 ? 'pl-7' : 'pl-4'
                  }`}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</Base>

<!--
  Tailwind v4 here has no typography plugin, so the markdown element styles are
  written by hand. Deliberately modest: spacing, weight and the shared colour
  tokens, nothing decorative.
-->
<style is:global>
  .prose {
    max-width: 46rem;
    line-height: 1.7;
  }

  .prose > :first-child {
    margin-top: 0;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    color: var(--color-text);
    font-weight: 600;
    line-height: 1.3;
    scroll-margin-top: 5rem;
  }

  .prose h1 {
    margin-bottom: 1rem;
    font-size: 2rem;
  }

  .prose h2 {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 1.35rem;
  }

  .prose h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .prose p,
  .prose ul,
  .prose ol {
    margin-block: 1rem;
    color: var(--color-text-dim);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.5rem;
  }

  .prose ul {
    list-style: disc;
  }

  .prose ol {
    list-style: decimal;
  }

  .prose li {
    margin-block: 0.35rem;
  }

  .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.3rem;
    padding: 0.1rem 0.35rem;
  }

  .prose pre {
    margin-block: 1.25rem;
    overflow-x: auto;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }

  /* Inside a code block the inline chip styling would double up. */
  .prose pre code {
    background: none;
    border: 0;
    padding: 0;
    font-size: 0.85rem;
  }

  .prose blockquote {
    margin-block: 1.25rem;
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-text-dim);
  }

  .prose table {
    margin-block: 1.5rem;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .prose th {
    background-color: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
  }

  .prose td {
    color: var(--color-text-dim);
  }

  .prose hr {
    margin-block: 2rem;
    border: 0;
    border-top: 1px solid var(--color-border);
  }
</style>
