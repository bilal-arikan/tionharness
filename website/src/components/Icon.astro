---
// Inline stroke icons. Kept local instead of pulling an icon package so the
// build stays dependency-free and every glyph ships in the HTML.
interface Props {
  name: string
  class?: string
}

const { name, class: className = 'size-5' } = Astro.props

const paths: Record<string, string> = {
  agent: 'M12 3a4 4 0 0 1 4 4v1a4 4 0 0 1-8 0V7a4 4 0 0 1 4-4ZM5 21v-1a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v1',
  tree: 'M12 4v4m0 0L6 12m6-4 6 4M6 12v4m12-4v4M4 18h4m8 0h4m-12 0h4',
  flow: 'M4 7h5m0 0a2 2 0 1 0 4 0m-4 0a2 2 0 1 1 4 0m0 0h7M4 17h7m0 0a2 2 0 1 0 4 0m-4 0a2 2 0 1 1 4 0m0 0h5M13 9v6',
  board: 'M4 5h4v14H4zM10 5h4v9h-4zM16 5h4v6h-4z',
  workspace: 'M4 6a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z',
  tool: 'M14.7 6.3a4 4 0 0 0 5 5L21 10l-7 7-3-3 7-7ZM8 13l3 3-4 4a2 2 0 0 1-3-3l4-4Z',
  shield: 'M12 3l7 3v6c0 4.4-3 8-7 9-4-1-7-4.6-7-9V6l7-3Zm-2.5 9 2 2 3.5-4',
  gear: 'M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6ZM19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1V21a2 2 0 1 1-4 0v-.2a1.6 1.6 0 0 0-2.7-1.1l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.6 1.6 0 0 0 3.6 15H3a2 2 0 1 1 0-4h.2a1.6 1.6 0 0 0 1.1-2.7l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.6 1.6 0 0 0 10 4.6V4a2 2 0 1 1 4 0v.2a1.6 1.6 0 0 0 2.7 1.1l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0 1.1 2.7H21a2 2 0 1 1 0 4h-.2a1.6 1.6 0 0 0-1.4 1Z',
  search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14Zm5 12 4 4',
  download: 'M12 4v10m0 0 4-4m-4 4-4-4M5 19h14',
  arrow: 'M5 12h13m0 0-5-5m5 5-5 5',
  check: 'M5 12.5 9.5 17 19 7',
  cross: 'M6 6l12 12M18 6 6 18',
  warn: 'M12 4 2.5 20h19L12 4Zm0 6v5m0 3h.01',
  book: 'M4 5a2 2 0 0 1 2-2h12v18H6a2 2 0 0 1-2-2V5Zm4 0v14',
  code: 'M9 8l-4 4 4 4m6-8 4 4-4 4',
}

const d = paths[name] ?? paths.agent
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d} />
</svg>
