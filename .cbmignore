# Paths the code-search indexers (codebase-memory, zvec-grep) must skip.
#
# These tools do NOT read .gitignore, so a directory can be invisible to git and
# still pollute search results. Everything listed here is build output or a
# throwaway checkout: indexing it produces a second, stale copy of real source
# files, and a symbol search then returns two hits for one definition.

# Release packaging scratch space. The release test harness checks the whole
# repo out under dist/release-test-worktree/, so an old copy of internal/agent
# can reappear here at any time and make every symbol in it match twice. One
# such stale checkout was removed by hand in TSK954; this entry keeps the next
# one out of the index.
dist/

# Build output.
frontend/dist/
internal/web/dist/
website/dist/
node_modules/

# Live worktrees of other repos; each is its own project and indexed separately.
.tionharness-worktrees/
