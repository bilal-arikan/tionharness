{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tionharness",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-File",
        "scripts/serve.ps1",
        "-Loopback",
        "-NoKillPort"
      ],
      "port": 8090
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "tionharness-scratch",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:TIONHARNESS_ADDR='127.0.0.1:8090'; $env:TIONHARNESS_DATA_DIR=\"$env:LOCALAPPDATA\\Temp\\claude\\th-scratch-data\"; go run ./cmd/tionharness"
      ],
      "port": 8090
    },
    {
      "name": "tionharness-dev",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": [
        "-NoProfile",
        "-File",
        "scripts/dev.ps1",
        "-BackendOnly",
        "-Loopback",
        "-NoBrowser",
        "-NoKillPort"
      ],
      "port": 8090
    }
  ]
}
